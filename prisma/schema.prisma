generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  passwordHash  String
  pinHash       String
  createdAt     DateTime     @default(now())
  accounts      Account[]
  creditCards   CreditCard[]
  loans         Loan[]
  savingsGoals   SavingsGoal[]
  investments    Investment[]
}

model Admin {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Account {
  id            String        @id @default(cuid())
  accountNumber String        @unique @default(cuid())
  type          String        @default("checking")
  currency      String        @default("USD")
  balance       Decimal       @default(1000.00) @db.Decimal(12, 2)
  frozen        Boolean       @default(false)
  frozenReason  String?
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sentTx        Transaction[] @relation("SenderAccount")
  receivedTx    Transaction[] @relation("ReceiverAccount")
  createdAt     DateTime      @default(now())
}

model Transaction {
  id           String   @id @default(cuid())
  amount       Decimal  @db.Decimal(12, 2)
  description  String?
  externalLabel String?
  status       String   @default("completed")
  fromId       String?
  from         Account? @relation("SenderAccount", fields: [fromId], references: [id])
  toId         String?
  to           Account? @relation("ReceiverAccount", fields: [toId], references: [id])
  createdAt    DateTime @default(now())
}

model CreditCard {
  id           String            @id @default(cuid())
  cardNumber   String            @unique @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance      Decimal           @default(0) @db.Decimal(12, 2)
  currency     String            @default("USD")
  creditLimit  Decimal           @default(2000.00) @db.Decimal(12, 2)
  status       String            @default("active")
  createdAt    DateTime          @default(now())
  transactions CardTransaction[]
}

model CardTransaction {
  id        String     @id @default(cuid())
  cardId    String
  card      CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  merchant  String
  amount    Decimal    @db.Decimal(12, 2)
  createdAt DateTime   @default(now())
}
model PendingTransfer {
  id                String   @id @default(cuid())
  userId            String
  userName          String
  fromAccountId     String
  fromAccountNumber String
  toAccountNumber   String
  toAccountName     String?
  toAccountType     String?
  amount            Decimal  @db.Decimal(12, 2)
  currency          String   @default("USD")
  description       String?
  otpCode           String
  status            String   @default("pending")
  expiresAt         DateTime
  createdAt         DateTime @default(now())
}

model Loan {
  id              String        @id @default(cuid())
  loanNumber      String        @unique @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String        @default("Personal")
  principal       Decimal       @db.Decimal(12, 2)
  balance         Decimal       @db.Decimal(12, 2)
  interestRate    Decimal       @db.Decimal(5, 2)
  termMonths      Int
  monthlyPayment  Decimal       @db.Decimal(12, 2)
  currency        String        @default("USD")
  status          String        @default("active")
  nextPaymentDate DateTime?
  createdAt       DateTime      @default(now())
  payments        LoanPayment[]
}

model LoanPayment {
  id            String   @id @default(cuid())
  loanId        String
  loan          Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  amount        Decimal  @db.Decimal(12, 2)
  fromAccountId String?
  createdAt     DateTime @default(now())
}

model SavingsGoal {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  category      String    @default("General")
  targetAmount  Decimal   @db.Decimal(12, 2)
  currentAmount Decimal   @default(0) @db.Decimal(12, 2)
  currency      String    @default("USD")
  targetDate    DateTime?
  status        String    @default("active")
  createdAt     DateTime  @default(now())
}

model Investment {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  category     String   @default("Stocks")
  costBasis    Decimal  @db.Decimal(12, 2)
  currentValue Decimal  @db.Decimal(12, 2)
  currency     String   @default("USD")
  status       String   @default("active")
  createdAt    DateTime @default(now())
}
